---
/* Page hero for every interior page: solid navy-deep, eyebrow + H1 +
   lede, no map. The H1 is the page's single H1 and carries the target
   search term; it reveals on load. */

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  <div class="shell page-hero__inner" data-lift-group>
    <p class="mono page-hero__eyebrow" data-lift>{eyebrow}</p>
    <h1 class="display page-hero__title" data-reveal-h1>{title}</h1>
    <p class="lede page-hero__lede" data-lift>{lede}</p>
    <div class="page-hero__actions" data-lift>
      <a class="btn btn--primary" href="#enquiry">Request a quote</a>
      <slot name="secondary" />
    </div>
  </div>
</section>

<style>
  .page-hero {
    background: var(--navy-deep);
    border-bottom: 1px solid var(--border);
    /* Clears the fixed nav. */
    padding-block: calc(var(--section-pad) + 72px) var(--section-pad);
  }

  .page-hero__eyebrow { margin-bottom: var(--space-24); }

  .page-hero__title { max-width: 18ch; }

  .page-hero__lede {
    margin-top: var(--space-32);
    max-width: 58ch;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
    margin-top: var(--space-40);
  }
</style>
