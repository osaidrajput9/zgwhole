---
/* Weight readout — two values plus the matched mark.
 *
 * The argument the whole page rests on, stated as a measurement rather
 * than a promise: what went on at the loading weighbridge, what came off
 * at the discharge weighbridge, and the fact that they agree.
 *
 * The figure is the PRD's assumed typical load and is NOT yet confirmed
 * by the client. It is marked as typical in the copy for that reason.
 */

interface Props {
  load?: number;
  discharge?: number;
}
const { load = 31.4, discharge = 31.4 } = Astro.props;
const matched = load === discharge;
---

<div class="readout solid" data-readout>
  <div class="readout__pair">
    <div class="readout__value">
      <p class="mono readout__label">At load · weighbridge</p>
      <p class="figure readout__figure">
        <span data-weight={load}>0.00</span><span class="readout__unit">t</span>
      </p>
    </div>

    <div class="readout__rule" aria-hidden="true"></div>

    <div class="readout__value">
      <p class="mono readout__label">At discharge · weighbridge</p>
      <p class="figure readout__figure">
        <span data-weight={discharge}>0.00</span><span class="readout__unit">t</span>
      </p>
    </div>
  </div>

  <p class="readout__mark" data-mark>
    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
      <path d="M2.5 8.4l3.6 3.6L13.5 4.6" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>{matched ? "Matched" : "Variance recorded"}</span>
  </p>

  <p class="readout__note">
    A typical tanker load, captured at both ends and recorded against the
    consignment. Figures shown are representative of a standard run.
  </p>
</div>

<script>
  import { gsap } from "gsap";
  import { EASE, DUR, START, countUp, prefersReducedMotion } from "../lib/motion.js";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  document.querySelectorAll<HTMLElement>("[data-readout]").forEach((readout) => {
    const values = readout.querySelectorAll<HTMLElement>("[data-weight]");
    const mark = readout.querySelector<HTMLElement>("[data-mark]");
    const format = (v: number) => v.toFixed(2);

    if (prefersReducedMotion()) {
      values.forEach((el) => {
        el.textContent = format(Number(el.dataset.weight));
      });
      if (mark) gsap.set(mark, { opacity: 1, y: 0 });
      return;
    }

    if (mark) gsap.set(mark, { opacity: 0, y: 12 });

    ScrollTrigger.create({
      trigger: readout,
      start: START,
      once: true,
      onEnter: () => {
        values.forEach((el) => countUp(el, Number(el.dataset.weight), { format }));

        /* The mark lands after both figures have settled — the point is
           that they agree, so it cannot arrive before they are readable. */
        if (mark) {
          gsap.to(mark, {
            opacity: 1,
            y: 0,
            duration: DUR.lift,
            ease: EASE.lift,
            delay: DUR.carry,
          });
        }
      },
    });
  });
</script>

<style>
  .readout { padding: var(--space-32); }

  .readout__pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-24);
  }

  .readout__label { margin-bottom: var(--space-12); }

  .readout__figure {
    display: flex;
    align-items: baseline;
    gap: 2px;
    color: var(--cream);
  }

  .readout__unit {
    font-size: 0.4em;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .readout__rule {
    width: 1px;
    align-self: stretch;
    background: var(--border);
  }

  .readout__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-24);
    padding: var(--space-8) var(--space-12);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-button);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--cream);
  }

  .readout__note {
    margin-top: var(--space-20);
    max-width: 48ch;
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .readout__pair { grid-template-columns: 1fr; }
    .readout__rule { width: 100%; height: 1px; }
  }
</style>
