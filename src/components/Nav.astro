---
/* Floating nav — glass, because it floats over content. Pinned 16px from
   the top, capped at the 1320px content width.

   Six items per the PRD: Services (dropdown to the three service pages),
   Fleet, Tracking, About, Contact, and the quote button. Orders and
   Assigned Vehicle Tracking are footer-only until they are real. */

import Logo from "./Logo.astro";

interface Props { path?: string }
const { path = "" } = Astro.props;

const services = [
  { href: "/edible-oil-transportation", label: "Edible oil transportation" },
  { href: "/molasses-transportation",   label: "Molasses transportation" },
  { href: "/containers-finished-goods", label: "Containers and finished goods" },
];

const links = [
  { href: "/fleet",    label: "Fleet" },
  { href: "/tracking", label: "Tracking" },
  { href: "/about",    label: "About" },
  { href: "/contact",  label: "Contact" },
];

/* PLACEHOLDER: no telephone number in the brief. Replace TEL_HREF and
   the footer's number together once the client confirms it. */
const TEL_HREF = "tel:+920000000000";

const isActive = (href: string) => path === href;
const servicesActive = services.some((s) => isActive(s.href));
---

<header class="nav-shell">
  <nav class="nav glass" aria-label="Primary">
    <a class="nav__brand" href="/" aria-label="Zia Goods and Carriage Contractor — home">
      <Logo height="30px" />
    </a>

    <ul class="nav__links">
      <li class="nav__item nav__item--has-menu">
        <button
          type="button"
          class="nav__link nav__trigger"
          aria-expanded="false"
          aria-controls="services-menu"
          data-services-trigger
          aria-current={servicesActive ? "true" : undefined}
        >
          Services
          <svg class="nav__chev" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>

        <div class="nav__menu glass" id="services-menu" data-services-menu hidden>
          <ul>
            {services.map((s) => (
              <li>
                <a href={s.href} aria-current={isActive(s.href) ? "page" : undefined}>
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      {links.map((l) => (
        <li class="nav__item">
          <a class="nav__link" href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav__actions">
      <a class="nav__tel" href={TEL_HREF} data-placeholder>
        <span class="visually-hidden">Call Zia Goods</span>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            d="M5.2 1.8 6.6 4.6 5.3 6a9.4 9.4 0 0 0 4.7 4.7l1.4-1.3 2.8 1.4v2.4c0 .5-.4.9-.9.8A12.6 12.6 0 0 1 1.9 2.9c0-.5.3-.9.8-.9h2.5Z"
            fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"
          />
        </svg>
      </a>

      <a class="btn btn--primary nav__quote" href="/contact">Request a quote</a>

      <button
        type="button"
        class="nav__burger"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-burger
      >
        <span class="visually-hidden">Menu</span>
        <span class="nav__burger-bar" aria-hidden="true"></span>
        <span class="nav__burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <div class="nav__mobile glass" id="mobile-menu" data-mobile-menu hidden>
    <ul>
      {[...services, ...links].map((l) => (
        <li>
          <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
        </li>
      ))}
      <li><a class="btn btn--primary" href="/contact">Request a quote</a></li>
    </ul>
  </div>
</header>

<script>
  import { gsap } from "gsap";
  import { EASE, DUR, prefersReducedMotion } from "../lib/motion.js";

  /* Menus are Snap — fast, precise, mechanical. Both easing and duration
     come from motion.js; neither is written here. */

  const open = (panel: HTMLElement, trigger: HTMLElement) => {
    panel.hidden = false;
    trigger.setAttribute("aria-expanded", "true");

    if (prefersReducedMotion()) {
      gsap.set(panel, { opacity: 1, y: 0 });
      return;
    }
    gsap.fromTo(
      panel,
      { opacity: 0, y: -8 },
      { opacity: 1, y: 0, duration: DUR.snap, ease: EASE.snap },
    );
  };

  const close = (panel: HTMLElement, trigger: HTMLElement) => {
    trigger.setAttribute("aria-expanded", "false");

    if (prefersReducedMotion()) {
      panel.hidden = true;
      return;
    }
    gsap.to(panel, {
      opacity: 0,
      y: -8,
      duration: DUR.snap,
      ease: EASE.snap,
      onComplete: () => { panel.hidden = true; },
    });
  };

  const wire = (trigger: HTMLElement | null, panel: HTMLElement | null) => {
    if (!trigger || !panel) return;

    const toggle = () =>
      trigger.getAttribute("aria-expanded") === "true"
        ? close(panel, trigger)
        : open(panel, trigger);

    trigger.addEventListener("click", (e) => { e.stopPropagation(); toggle(); });

    document.addEventListener("click", (e) => {
      if (trigger.getAttribute("aria-expanded") !== "true") return;
      if (panel.contains(e.target as Node) || trigger.contains(e.target as Node)) return;
      close(panel, trigger);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (trigger.getAttribute("aria-expanded") !== "true") return;
      close(panel, trigger);
      trigger.focus();
    });
  };

  wire(
    document.querySelector<HTMLElement>("[data-services-trigger]"),
    document.querySelector<HTMLElement>("[data-services-menu]"),
  );
  wire(
    document.querySelector<HTMLElement>("[data-burger]"),
    document.querySelector<HTMLElement>("[data-mobile-menu]"),
  );
</script>

<style>
  .nav-shell {
    position: fixed;
    inset-block-start: var(--space-16);
    inset-inline: 0;
    z-index: 50;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  .nav {
    pointer-events: auto;
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--space-24);
    padding: var(--space-12) var(--space-16) var(--space-12) var(--space-20);
  }

  .nav__brand { display: flex; align-items: center; color: var(--cream); }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-inline-start: var(--space-8);
  }

  .nav__item { position: relative; }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 44px;
    padding-inline: var(--space-12);
    background: none;
    border: 0;
    border-radius: var(--radius-button);
    color: var(--text-secondary);
    font-size: var(--size-small);
    letter-spacing: -0.005em;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--hover-duration) var(--hover-ease),
                background-color var(--hover-duration) var(--hover-ease);
  }
  .nav__link:hover { color: var(--text-primary); background: var(--fill-hover); }
  .nav__link[aria-current] { color: var(--text-primary); }

  .nav__chev { transition: transform var(--hover-duration) var(--hover-ease); }
  .nav__trigger[aria-expanded="true"] .nav__chev { transform: rotate(180deg); }

  .nav__menu {
    position: absolute;
    inset-block-start: calc(100% + var(--space-8));
    inset-inline-start: 0;
    min-width: 268px;
    padding: var(--space-8);
  }
  .nav__menu a {
    display: block;
    padding: var(--space-12);
    border-radius: var(--radius-button);
    font-size: var(--size-small);
    transition: color var(--hover-duration) var(--hover-ease),
                background-color var(--hover-duration) var(--hover-ease);
  }
  .nav__menu a:hover { background: var(--fill-hover); color: var(--text-primary); }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-inline-start: auto;
  }

  .nav__tel {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-button);
    color: var(--text-primary);
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 var(--space-12);
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-button);
    cursor: pointer;
  }
  .nav__burger-bar {
    display: block;
    height: 1.5px;
    background: var(--cream);
    border-radius: 2px;
  }

  .nav__mobile {
    pointer-events: auto;
    max-width: var(--max-width);
    margin: var(--space-8) auto 0;
    padding: var(--space-8);
  }
  .nav__mobile a:not(.btn) {
    display: block;
    padding: var(--space-16) var(--space-12);
    font-size: var(--size-small);
  }
  .nav__mobile .btn { width: 100%; margin-top: var(--space-8); }

  /* The desktop nav collapses below 1000px, per the PRD. */
  @media (max-width: 1000px) {
    .nav__links, .nav__quote { display: none; }
    .nav__tel, .nav__burger { display: flex; }
  }

  @media (min-width: 1001px) {
    .nav__mobile { display: none; }
  }
</style>
