---
/* The mark is inlined rather than loaded through <img> so its fill can
   inherit currentColor from the surrounding text colour. An external SVG
   in an <img> cannot see the page's CSS, and renders black. */
import raw from "../../public/zia-goods-lockup.svg?raw";

interface Props {
  /** Rendered height, e.g. "30px". Set here rather than from the parent:
      a scoped class on a component root does not reach this element. */
  height?: string;
  class?: string;
}
const { height = "30px", class: className = "" } = Astro.props;

/* The parent link carries the accessible name, so the mark itself is
   hidden from assistive technology rather than announced twice. */
const svg = raw
  .replace(/<title>.*?<\/title>/s, "")
  .replace(/\s(width|height)="[^"]*"/g, "")
  .replace(/role="img"/, 'role="presentation" aria-hidden="true" focusable="false"')
  .replace(/\saria-label="[^"]*"/, "");
---

<span
  class={`logo ${className}`.trim()}
  style={`--logo-height: ${height}`}
  set:html={svg}
/>

<style>
  .logo {
    display: inline-flex;
    flex: none;
    height: var(--logo-height);
  }

  /* The span's width comes from its content and the svg's width comes
     from `auto`, which is circular and collapses to zero. Pinning the
     mark's own ratio lets the height drive the width. */
  .logo :global(svg) {
    height: 100%;
    width: auto;
    aspect-ratio: 939 / 602.63;
    flex: none;
  }
</style>
